{
  "$defs": {
    "cvtState": {
      "additionalProperties": false,
      "properties": {
        "belt_speed_m_per_s": {
          "type": "number"
        },
        "primary_angular_speed_rad_per_s": {
          "type": "number"
        },
        "secondary_angular_speed_rad_per_s": {
          "type": "number"
        },
        "shift_position_m": {
          "type": "number"
        },
        "shift_speed_m_per_s": {
          "type": "number"
        }
      },
      "required": [
        "primary_angular_speed_rad_per_s",
        "secondary_angular_speed_rad_per_s",
        "belt_speed_m_per_s",
        "shift_position_m",
        "shift_speed_m_per_s"
      ],
      "type": "object"
    },
    "fixedShaftBoundary": {
      "additionalProperties": false,
      "properties": {
        "equivalent_inertia_kg_m2": {
          "minimum": 0.0,
          "type": "number"
        },
        "external_torque_Nm": {
          "type": "number"
        },
        "kind": {
          "const": "fixed_shaft"
        }
      },
      "required": [
        "kind",
        "external_torque_Nm",
        "equivalent_inertia_kg_m2"
      ],
      "type": "object"
    },
    "fullThrottleEngineBoundary": {
      "additionalProperties": false,
      "properties": {
        "equivalent_rotational_inertia_kg_m2": {
          "minimum": 0.0,
          "type": "number"
        },
        "high_speed_braking_torque_Nm": {
          "type": "number"
        },
        "high_speed_braking_transition_width_rad_per_s": {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        "kind": {
          "const": "full_throttle_engine"
        },
        "low_speed_braking_peak_speed_rad_per_s": {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        "low_speed_braking_torque_Nm": {
          "type": "number"
        },
        "points": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "angular_speed_rad_per_s": {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              "torque_Nm": {
                "type": "number"
              }
            },
            "required": [
              "angular_speed_rad_per_s",
              "torque_Nm"
            ],
            "type": "object"
          },
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "kind",
        "points",
        "low_speed_braking_torque_Nm",
        "low_speed_braking_peak_speed_rad_per_s",
        "high_speed_braking_torque_Nm",
        "high_speed_braking_transition_width_rad_per_s",
        "equivalent_rotational_inertia_kg_m2"
      ],
      "type": "object"
    },
    "host": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "initial_state": {
              "additionalProperties": false,
              "properties": {
                "secondary_shaft_angle_rad": {
                  "type": "number"
                }
              },
              "required": [
                "secondary_shaft_angle_rad"
              ],
              "type": "object"
            },
            "kind": {
              "const": "secondary_shaft_angle"
            }
          },
          "required": [
            "kind",
            "initial_state"
          ],
          "type": "object"
        }
      ]
    },
    "integrator": {
      "additionalProperties": false,
      "properties": {
        "absolute_tolerance": {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        "event_time_tolerance": {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        "first_step": {
          "type": [
            "number",
            "null"
          ]
        },
        "max_step": {
          "type": [
            "number",
            "string"
          ]
        },
        "maximum_transitions": {
          "minimum": 1,
          "type": "integer"
        },
        "method": {
          "type": "string"
        },
        "relative_tolerance": {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        "retain_dense_output": {
          "type": "boolean"
        }
      },
      "required": [
        "relative_tolerance",
        "absolute_tolerance",
        "method",
        "max_step",
        "first_step",
        "maximum_transitions",
        "event_time_tolerance",
        "retain_dense_output"
      ],
      "type": "object"
    },
    "lockedFinalDriveBoundary": {
      "additionalProperties": false,
      "properties": {
        "direct_secondary_shaft_inertia_kg_m2": {
          "minimum": 0.0,
          "type": "number"
        },
        "final_drive": {
          "additionalProperties": false,
          "properties": {
            "reduction_ratio": {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            "wheel_radius_m": {
              "exclusiveMinimum": 0.0,
              "type": "number"
            }
          },
          "required": [
            "reduction_ratio",
            "wheel_radius_m"
          ],
          "type": "object"
        },
        "kind": {
          "const": "locked_final_drive"
        },
        "road_load": {
          "additionalProperties": false,
          "properties": {
            "air_density_kg_per_m3": {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            "drag_coefficient": {
              "minimum": 0.0,
              "type": "number"
            },
            "frontal_area_m2": {
              "minimum": 0.0,
              "type": "number"
            },
            "gravity_m_per_s2": {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            "rolling_resistance_coefficient": {
              "minimum": 0.0,
              "type": "number"
            },
            "rolling_speed_regularization_m_per_s": {
              "exclusiveMinimum": 0.0,
              "type": "number"
            }
          },
          "required": [
            "rolling_resistance_coefficient",
            "drag_coefficient",
            "frontal_area_m2",
            "air_density_kg_per_m3",
            "gravity_m_per_s2",
            "rolling_speed_regularization_m_per_s"
          ],
          "type": "object"
        },
        "road_profile": {
          "$ref": "#/$defs/roadProfile"
        },
        "vehicle": {
          "additionalProperties": false,
          "properties": {
            "mass_kg": {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            "wheel_rotational_inertia_kg_m2": {
              "minimum": 0.0,
              "type": "number"
            }
          },
          "required": [
            "mass_kg",
            "wheel_rotational_inertia_kg_m2"
          ],
          "type": "object"
        }
      },
      "required": [
        "kind",
        "vehicle",
        "final_drive",
        "road_load",
        "road_profile",
        "direct_secondary_shaft_inertia_kg_m2"
      ],
      "type": "object"
    },
    "reporting": {
      "type": "object"
    },
    "roadProfile": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "grade_angle_rad": {
              "type": "number"
            },
            "kind": {
              "const": "constant_grade"
            }
          },
          "required": [
            "kind",
            "grade_angle_rad"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "piecewise_constant_grade"
            },
            "segments": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "grade_angle_rad": {
                    "type": "number"
                  },
                  "start_distance_m": {
                    "minimum": 0.0,
                    "type": "number"
                  }
                },
                "required": [
                  "start_distance_m",
                  "grade_angle_rad"
                ],
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "segments"
          ],
          "type": "object"
        }
      ]
    },
    "shaftBoundary": {
      "oneOf": [
        {
          "$ref": "#/$defs/fixedShaftBoundary"
        },
        {
          "$ref": "#/$defs/fullThrottleEngineBoundary"
        },
        {
          "$ref": "#/$defs/lockedFinalDriveBoundary"
        }
      ]
    }
  },
  "$id": "https://cinder-cvt.local/schema/composed-simulation-case.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assembly": {
      "type": "object"
    },
    "document_type": {
      "const": "cinder_composed_simulation_case"
    },
    "execution": {
      "additionalProperties": false,
      "properties": {
        "integrator": {
          "$ref": "#/$defs/integrator"
        },
        "reporting": {
          "$ref": "#/$defs/reporting"
        }
      },
      "required": [
        "integrator",
        "reporting"
      ],
      "type": "object"
    },
    "host": {
      "$ref": "#/$defs/host"
    },
    "scenario": {
      "additionalProperties": false,
      "properties": {
        "initial_cvt_state": {
          "$ref": "#/$defs/cvtState"
        },
        "time_span_s": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "type": "array"
        }
      },
      "required": [
        "time_span_s",
        "initial_cvt_state"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": 1
    },
    "shaft_boundaries": {
      "additionalProperties": false,
      "properties": {
        "primary": {
          "$ref": "#/$defs/shaftBoundary"
        },
        "secondary": {
          "$ref": "#/$defs/shaftBoundary"
        }
      },
      "required": [
        "primary",
        "secondary"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "document_type",
    "assembly",
    "shaft_boundaries",
    "host",
    "scenario",
    "execution"
  ],
  "title": "CINDER composed CVT simulation case",
  "type": "object"
}
