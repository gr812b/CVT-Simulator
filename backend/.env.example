# Export these variables in your shell before starting the API.
# Uvicorn also supports --env-file .env when python-dotenv is installed.
CVT_DATABASE_URL=sqlite:///./cvt_simulator_dev.db
CVT_ENVIRONMENT=development
CVT_WEB_URL=http://localhost:5173
CVT_CORS_ORIGINS=http://localhost:5173
CVT_MAIL_MODE=outbox
CVT_MAIL_OUTBOX=.local/mail
CVT_SESSION_LIFETIME_SECONDS=604800
CVT_RESET_LIFETIME_SECONDS=1800

# Production requires HTTPS and SMTP. Never commit real credentials.
# CVT_ENVIRONMENT=production
# CVT_WEB_URL=https://your-cinder-host.example
# CVT_CORS_ORIGINS=https://your-cinder-host.example
# CVT_MAIL_MODE=smtp
# CVT_SMTP_HOST=smtp.example
# CVT_SMTP_PORT=587
# CVT_SMTP_SECURITY=starttls
# CVT_SMTP_USERNAME=
# CVT_SMTP_PASSWORD=
# CVT_SMTP_FROM=CINDER <noreply@your-cinder-host.example>
