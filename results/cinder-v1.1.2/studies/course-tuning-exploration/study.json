{
  "results_manifest_schema": 1,
  "schema_version": 1,
  "study_slug": "course-tuning-exploration",
  "name": "Common-course CVT tuning exploration",
  "title": "Common-course CVT tuning exploration",
  "description": "Full-throttle, distance-based off-road comparison of physically motivated CVT tunes. Exploratory evidence for selecting a later manuscript case set.",
  "maintenance_status": "maintained",
  "paper_role": "undecided",
  "classification": "system",
  "cinder_release": {
    "distribution": "cinder-cvt",
    "version": "1.1.2",
    "source_tag": "cinder-v1.1.2",
    "source_commit_sha": "7637a38b4fb9ec21dfb953c1c80a27ec5f389654"
  },
  "scientific_question": "Where does each tune gain or lose course progress, and which actuator, shift, contact or travel-limit mechanism explains the difference?",
  "base_document": "../../defaults/baja/simulation_case.json",
  "base_configuration": "../../defaults/baja/simulation_case.json",
  "reference_model": {
    "policy": "bilateral-slotted",
    "source": "../../defaults/reference_model/policy.json"
  },
  "entrypoints": {
    "run": "run.py",
    "verify": "verify_study.py"
  },
  "outputs": {
    "directory": "artifacts",
    "committed": false
  },
  "runtime_scope": {
    "requires": [
      "cinder-cvt==1.1.2",
      "release-scoped Results defaults"
    ],
    "forbids": [
      "editable cvtModel/src",
      "runtime Git materialization",
      "test-only CVT mechanics"
    ]
  },
  "source_ownership": {
    "shared_cross_study": "../../defaults",
    "study_specific": "infrastructure/, experiments/, analysis/, inputs/",
    "exploration_excluded_from_run": true
  },
  "run_contract": "Reproduce the selected exploratory fleet on one immutable course/configuration. No outputs are designated manuscript results. Optional multi-course sweeps in exploration/ are not invoked by run.py.",
  "inputs": {
    "course": "inputs/course.json",
    "competitors": "inputs/competitors.json"
  },
  "presets": {
    "smoke": {
      "relative_tolerance": 0.0001,
      "absolute_tolerance": 1e-07,
      "max_step_s": 0.01,
      "maximum_time_s": 3.0,
      "diagnostic_step_s": 0.02
    },
    "screen": {
      "relative_tolerance": 0.0001,
      "absolute_tolerance": 1e-07,
      "max_step_s": 0.02,
      "maximum_time_s": 180.0,
      "diagnostic_step_s": 0.025
    },
    "research": {
      "relative_tolerance": 0.0001,
      "absolute_tolerance": 1e-07,
      "max_step_s": 0.01,
      "maximum_time_s": 180.0,
      "diagnostic_step_s": 0.01
    },
    "tight": {
      "relative_tolerance": 3e-05,
      "absolute_tolerance": 3e-08,
      "max_step_s": 0.005,
      "maximum_time_s": 180.0,
      "diagnostic_step_s": 0.005
    }
  },
  "execution": {
    "checkpoint_interval_s": 2.0,
    "maximum_transitions_per_checkpoint": 600,
    "maximum_total_transitions": 5000,
    "event_time_tolerance_s": 1e-10,
    "case_wall_timeout_s": 1800.0,
    "progress_monitor_after_s": 20.0,
    "no_progress_window_s": 15.0,
    "no_progress_distance_m": 0.25,
    "rollback_stop_speed_m_s": -0.25
  },
  "diagnostics": {
    "distance_grid_step_m": 0.25,
    "mechanism_map_points": 41,
    "event_window_s": 0.25,
    "physical_margin_review_tolerance": 1e-05
  },
  "interpretation": [
    "No global optimization is claimed.",
    "Course or tune changes produce a new campaign fingerprint.",
    "Stall/progress and rollback stops are study-level observations, not proof of physical impossibility.",
    "An exception or model-domain termination is not classified as vehicle failure.",
    "The built-in full-throttle map retains its original non-driving tails; reverse power is measured, never forced.",
    "The road model assumes pure rolling, permanent tyre contact and no suspension dynamics."
  ],
  "study_specific": {
    "stage": "exploratory",
    "paper_selection": "not yet selected",
    "course_selection": "one fixed profile per campaign"
  }
}
