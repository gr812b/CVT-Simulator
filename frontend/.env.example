# Local Vite development only. The browser calls this origin directly.
# Do not append /api/v1: the frontend API facade already includes /api/v1 routes.
VITE_API_BASE_URL=http://localhost:8000

# Explicit local-development seed IDs created by `python -m app.scripts.init_database`.
# These are test/demo defaults only. Real auth should replace this boundary later.
VITE_DEMO_USER_ID=00000000-0000-4000-8000-000000000001
VITE_DEMO_ACCOUNT_ID=00000000-0000-4000-8000-000000000002
