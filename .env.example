# Copy this file to .env on the machine running Docker Compose.

# PostgreSQL password used by both the database container and the backend.
# Prefer a URL-safe value because it is embedded in CVT_DATABASE_URL.
# Example generator: openssl rand -hex 32
POSTGRES_PASSWORD=change-me

# Normal production deployments track the images published from develop.
# For a manually published branch build, set this to that image tag,
# for example: test-my-feature
CVT_TAG=latest

# Maximum simultaneous simulations in the single worker container.
# Processes start on demand and exit after each run; idle uses no solver processes.
# Start conservatively: each active simulation can use up to 4096 MiB of memory.
# Example: set 5 for up to five runs at once, if the host has sufficient CPU/RAM.
CVT_WORKER_MAX_CONCURRENCY=1

# External Docker network used by your reverse proxy.
WEB_NETWORK=web

# Public HTTPS origin and a verified SMTP sender.
CVT_WEB_URL=https://cinder.example.com
CVT_SMTP_HOST=smtp.example.com
CVT_SMTP_PORT=587
CVT_SMTP_SECURITY=starttls
CVT_SMTP_USERNAME=
CVT_SMTP_PASSWORD=
CVT_SMTP_FROM=CINDER <noreply@cinder.example.com>
